# ============================================
# HR-SaaS 后端环境变量配置（复制为 .env 后按需修改）
# ============================================

# 运行环境 (development/production)
ENVIRONMENT=development
DEBUG=true

# 数据库（默认 SQLite，文件在 backend/hr_saas.db；可换 MySQL 连接串）
DATABASE_URL=sqlite:///./hr_saas.db

# JWT 配置（生产环境务必换成强随机字符串）
SECRET_KEY=change...alue
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 跨域配置（逗号分隔，或 *）
CORS_ORIGINS=*

# 文件上传配置（简历原件 / 面试录音存放目录）
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# 阿里 Qwen 大模型 API（OpenAI 兼容协议；简历匹配 + AI 面试评分用）
LLM_API_KEY=***
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 语音转写（AI 面试语音作答，可选；不配置则语音作答自动禁用，文字作答不受影响）
DASHSCOPE_API_KEY=
***
